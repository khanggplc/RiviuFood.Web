@model IEnumerable<RiviuFood.Web.Models.Entities.Post>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Bảng điều khiển cá nhân";
    var user = ViewBag.UserInfo as IdentityUser;
}

<div class="max-w-7xl mx-auto my-8 px-4 font-sans">
    <div class="flex flex-col md:flex-row gap-6">

        <!-- THANH SIDEBAR TRÁI: THÔNG TIN USER & MENU -->
        <div class="w-full md:w-1/4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100 h-fit">
            <div class="text-center pb-6 border-b border-gray-100">
                <div class="w-20 h-20 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold text-3xl mx-auto mb-3 shadow-md">
                    @user?.Email?.Substring(0, 1).ToUpper()
                </div>
                <h3 class="font-bold text-gray-800 text-lg truncate">@user?.UserName</h3>
                <p class="text-xs text-gray-400 truncate">@user?.Email</p>
            </div>

            <nav class="mt-6 space-y-2">
                <a href="#" class="flex items-center space-x-3 bg-orange-50 text-orange-600 px-4 py-3 rounded-xl font-semibold text-sm transition">
                    📊 <span>Tổng quan & Bài viết</span>
                </a>
                <a href="/Identity/Account/Manage" class="flex items-center space-x-3 text-gray-600 hover:bg-gray-50 px-4 py-3 rounded-xl font-medium text-sm transition">
                    ⚙️ <span>Cài đặt tài khoản</span>
                </a>
            </nav>
        </div>

        <!-- VÙNG NỘI DUNG PHẢI: SỐ LIỆU & BẢNG QUẢN LÝ BÀI VIẾT -->
        <div class="flex-1 space-y-6">

            <!-- 3 THẺ THỐNG KÊ NHANH (CARDS) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-gradient-to-br from-orange-500 to-amber-500 p-5 rounded-2xl text-white shadow-sm">
                    <p class="text-xs font-medium opacity-80">Bài viết của bạn</p>
                    <h4 class="text-2xl font-bold mt-1">@ViewBag.TotalPosts</h4>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
                    <p class="text-xs font-medium text-gray-400">Lượt tim nhận được</p>
                    <h4 class="text-2xl font-bold text-gray-800 mt-1">❤️ @ViewBag.TotalLikes</h4>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
                    <p class="text-xs font-medium text-gray-400">Bình luận đã viết</p>
                    <h4 class="text-2xl font-bold text-gray-800 mt-1">💬 @ViewBag.TotalComments</h4>
                </div>
            </div>

            <!-- BẢNG DANH SÁCH BÀI VIẾT TẬP TRUNG -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center justify-between">
                    <h2 class="font-bold text-gray-800 text-base">Quản lý bài review đã đăng</h2>
                    <a href="/Post/Create" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition">
                        + Viết bài mới
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="p-8 text-center text-gray-400 text-sm">
                        Bạn chưa có bài viết review nào cả. Hãy bấm nút phía trên để chia sẻ món ngon đầu tiên nhé! 🥞
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-100">
                                    <th class="p-4">Bài viết</th>
                                    <th class="p-4">Quán ăn</th>
                                    <th class="p-4 text-center">Tương tác</th>
                                    <th class="p-4 text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                @foreach (var item in Model)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-4 max-w-xs">
                                            <p class="font-bold text-gray-800 truncate">@item.Title</p>
                                            <p class="text-[11px] text-gray-400 mt-0.5">📅 @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                        </td>
                                        <td class="p-4 text-gray-600 font-medium">
                                            📍 @(item.Restaurant?.Name ?? "Chưa rõ quán")
                                        </td>
                                        <td class="p-4 text-center space-x-3 text-xs">
                                            <span class="text-gray-600">❤️ @(item.PostLikes?.Count ?? 0)</span>
                                            <span class="text-gray-600">💬 @(item.Comments?.Count ?? 0)</span>
                                        </td>
                                        <td class="p-4 text-center">
                                            <div class="inline-flex items-center space-x-2">
                                                <a href="/Post/Edit/@item.Id" class="text-blue-600 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg font-semibold text-xs transition border border-blue-100">
                                                    Sửa
                                                </a>
                                                <a href="/Post/Delete/@item.Id" class="text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg font-semibold text-xs transition border border-red-100"
                                                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài review này không?')">
                                                    Xóa
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>