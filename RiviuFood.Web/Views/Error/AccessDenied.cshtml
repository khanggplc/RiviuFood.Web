@{
    Layout = null; // Không sử dụng layout chung để trang lỗi được cô lập hoàn toàn
    ViewData["Title"] = "403 - Không có quyền truy cập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen px-4">
    <div class="max-w-md w-full text-center bg-white p-8 rounded-3xl border border-gray-100 shadow-sm">
        <div class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl animate-bounce">
            🛑
        </div>
        
        <h1 class="text-6xl font-black text-gray-900 tracking-tight mb-2">403</h1>
        <h2 class="text-xl font-bold text-gray-800 mb-3">Truy cập bị từ chối!</h2>
        <p class="text-sm text-gray-400 leading-relaxed mb-8">
            Tài khoản hiện tại không có đặc quyền để truy cập vào phân hệ này. Khu vực này chỉ dành riêng cho Quản trị viên tối cao của hệ thống.
        </p>

        <div class="space-y-3">
            <a href="/" class="block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm py-3 rounded-xl shadow-md transition duration-200">
                Quay lại trang chủ
            </a>
            <a href="/Identity/Account/Login" class="block w-full bg-gray-50 hover:bg-gray-100 text-gray-600 font-bold text-sm py-3 rounded-xl transition duration-200">
                Đăng nhập bằng tài khoản khác
            </a>
        </div>
    </div>
</body>
</html>