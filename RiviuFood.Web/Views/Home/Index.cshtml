@model IEnumerable<RiviuFood.Web.Models.Entities.Post>
@{
    ViewData["Title"] = "Trang chủ - Thế giới ẩm thực RiviuFood";
}

<!-- Cover Banner -->


<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-12 font-sans">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-black text-gray-800 tracking-tight">🔥 Bài viết review mới nhất</h2>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentLocation))
        {
            <a href="@Url.Action("Index", "Home")" class="text-orange-500 font-bold hover:underline">Xóa bộ lọc</a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var post in Model)
            {
                <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition duration-300 transform hover:scale-105 cursor-pointer"
                     onclick="window.location.href='@Url.Action("Details", "Post", new { id = post.Id })'">
                    <!-- Post Image -->
                    <div class="relative w-full h-48 bg-gray-200 overflow-hidden">
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" alt="@post.Title" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-orange-200 to-amber-200">
                                <span class="text-4xl">📸</span>
                            </div>
                        }
                    </div>

                    <!-- Post Content -->
                    <div class="p-4">
                        <!-- Restaurant Name -->
                        <p class="text-xs font-bold text-orange-500 uppercase tracking-wide">
                            @post.Restaurant?.Name
                        </p>

                        <!-- Title -->
                        <h3 class="mt-2 text-lg font-bold text-gray-800 line-clamp-2">@post.Title</h3>

                        <!-- Rating -->
                        <div class="mt-2 flex items-center gap-1">
                            @for (int i = 0; i < post.Rating; i++)
                            {
                                <span class="text-yellow-400">⭐</span>
                            }
                            <span class="ml-1 text-sm font-semibold text-gray-600">@post.Rating/5</span>
                        </div>

                        <!-- Author & Date -->
                        <div class="mt-3 flex items-center justify-between text-xs text-gray-500">
                            <span>👤 @post.User?.UserName</span>
                            <span>📅 @post.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>

                        <!-- Like & Comment Count -->
                        <div class="mt-3 flex justify-between text-sm font-semibold text-gray-700">
                            <span>👍 @post.PostLikes?.Count() yêu thích</span>
                            <span>💬 @post.Comments?.Count() bình luận</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12">
            <p class="text-gray-500 text-lg">Không tìm thấy bài viết nào. Hãy thử tìm kiếm với từ khóa khác!</p>
        </div>
    }
</div>
