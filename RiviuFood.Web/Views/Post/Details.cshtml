@model RiviuFood.Web.Models.Entities.Post
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isLiked = Model.PostLikes != null && !string.IsNullOrEmpty(currentUserId)
                  && Model.PostLikes.Any(l => l.UserId == currentUserId);
    var likeCount = Model.PostLikes?.Count ?? 0;
}

<div class="max-w-4xl mx-auto my-10 px-4 font-sans">
    <div class="mb-6">
        <a href="javascript:history.back()" class="text-sm font-medium text-gray-500 hover:text-orange-500 transition flex items-center space-x-1">
            <span>←</span> <span>Quay lại trang trước</span>
        </a>
    </div>

    <article class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">

        <div class="w-full h-[400px] bg-gray-100 relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-full object-cover" />
            }
            else
            {
                <div class="w-full h-full flex items-center justify-center text-gray-400 bg-gray-50">
                    <span class="text-lg">📸 Bài viết chưa có hình ảnh</span>
                </div>
            }
        </div>

        <div class="p-8">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4 pb-4 border-b border-gray-100">
                <div>
                    <span class="text-xs font-bold text-orange-600 bg-orange-50 px-2.5 py-1 rounded-full uppercase tracking-wide">Địa điểm</span>
                    <h3 class="text-lg font-bold text-gray-800 mt-1">📍 @(Model.Restaurant?.Name ?? "Chưa rõ quán ăn")</h3>
                    <p class="text-sm text-gray-400">@(Model.Restaurant?.Address ?? "Chưa cập nhật địa chỉ")</p>
                </div>

                <div class="flex items-center space-x-1 bg-amber-50 px-4 py-2 rounded-2xl border border-amber-100">
                    <span class="text-amber-500 text-xl">⭐</span>
                    <span class="text-lg font-bold text-amber-700">@Model.Rating / 5</span>
                </div>
            </div>

            <h1 class="text-3xl font-extrabold text-gray-900 leading-tight mb-3">@Model.Title</h1>
            <div class="flex items-center text-xs text-gray-400 space-x-2 mb-6">
                <span>🕒 Đăng bởi: @(Model.User?.UserName ?? "Ẩn danh") | Lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="text-gray-700 leading-relaxed text-base whitespace-pre-line border-b border-gray-100 pb-8">
                @Model.Content
            </div>

            <!-- ===== LIKE SECTION ===== -->
            <div class="flex items-center gap-4 py-4 border-b border-gray-100">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <button id="btnToggleLike"
                            data-postid="@Model.Id"
                            data-liked="@isLiked.ToString().ToLower()"
                            class="flex items-center gap-2 px-5 py-2.5 rounded-full font-bold text-sm transition-all duration-200 border-2
                                   @(isLiked ? "bg-orange-500 text-white border-orange-500 shadow-md" : "bg-white text-gray-600 border-gray-200 hover:border-orange-400 hover:text-orange-500")">
                        <span id="likeIcon">@(isLiked ? "❤️" : "🤍")</span>
                        <span id="likeLabel">@(isLiked ? "Đã thích" : "Thích")</span>
                    </button>
                }
                else
                {
                    <a href="/Identity/Account/Login"
                       class="flex items-center gap-2 px-5 py-2.5 rounded-full font-bold text-sm border-2 border-gray-200 text-gray-500 hover:border-orange-400 hover:text-orange-500 transition-all">
                        🤍 Thích
                    </a>
                }

                <div class="flex items-center gap-1.5 text-sm text-gray-500">
                    <span>❤️</span>
                    <span id="likeCount" class="font-bold text-gray-700">@likeCount</span>
                    <span>lượt thích</span>
                </div>
            </div>
            <!-- ===== END LIKE SECTION ===== -->

            <div class="mt-8">
                <h3 class="text-xl font-bold text-gray-800 mb-4">💬 Bình luận từ cộng đồng</h3>

                <div id="commentList" class="space-y-4 mb-6">
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                        {
                            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 transition hover:bg-gray-100/50">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-sm font-bold text-gray-800">👤 @(comment.User?.UserName ?? "Thực khách")</span>
                                    <span class="text-xs text-gray-400">🕒 @comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p class="text-sm text-gray-600 pl-5 whitespace-pre-line">@comment.Content</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="noCommentText" class="p-6 bg-gray-50 rounded-2xl text-center text-sm text-gray-400">
                            Chưa có bình luận nào cho bài viết này. Hãy là người đầu tiên nêu cảm nghĩ nhé, Boss!
                        </div>
                    }
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="bg-orange-50/50 p-4 rounded-2xl border border-orange-100">
                        <label class="block text-xs font-bold text-orange-700 uppercase tracking-wider mb-2">Viết bình luận của bạn</label>
                        <div class="flex gap-3">
                            <textarea id="commentContent" rows="2" placeholder="Món này ngon không Boss? Không gian quán ổn chứ?..."
                                      class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-500 bg-white resize-none transition"></textarea>
                            <button id="btnSubmitComment" type="button" data-postid="@Model.Id"
                                    class="bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm px-5 rounded-xl shadow-sm transition h-fit py-3 self-end">
                                Gửi đi
                            </button>
                        </div>
                        <p id="commentError" class="text-xs text-red-500 mt-1 hidden"></p>
                    </div>
                }
                else
                {
                    <div class="p-4 bg-gray-50 rounded-2xl text-center text-sm text-gray-500 border border-dashed">
                        🔒 Vui lòng <a href="/Identity/Account/Login" class="text-orange-500 font-semibold hover:underline">Đăng nhập</a> để tham gia bình luận cùng cộng đồng.
                    </div>
                }
            </div>

        </div>
    </article>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ========== LIKE TOGGLE ==========
            const btnLike = document.getElementById("btnToggleLike");
            if (btnLike) {
                btnLike.addEventListener("click", async function () {
                    const postId = this.getAttribute("data-postid");
                    const icon   = document.getElementById("likeIcon");
                    const label  = document.getElementById("likeLabel");
                    const count  = document.getElementById("likeCount");

                    // Lấy token CSRF từ form ẩn của ASP.NET
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                                  || await fetch('/').then(() => ''); // fallback

                    try {
                        const formData = new FormData();
                        formData.append("postId", postId);

                        const response = await fetch('/Post/ToggleLike', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                            },
                            body: formData
                        });

                        if (!response.ok) throw new Error('Lỗi ' + response.status);

                        const data = await response.json();
                        if (data.success) {
                            const liked = data.isLiked;

                            // Cập nhật icon & label
                            icon.textContent  = liked ? '❤️' : '🤍';
                            label.textContent = liked ? 'Đã thích' : 'Thích';
                            count.textContent = data.totalLikes;

                            // Cập nhật style nút
                            if (liked) {
                                btnLike.classList.add('bg-orange-500', 'text-white', 'border-orange-500', 'shadow-md');
                                btnLike.classList.remove('bg-white', 'text-gray-600', 'border-gray-200');
                            } else {
                                btnLike.classList.remove('bg-orange-500', 'text-white', 'border-orange-500', 'shadow-md');
                                btnLike.classList.add('bg-white', 'text-gray-600', 'border-gray-200');
                            }

                            btnLike.setAttribute("data-liked", liked.toString());
                        }
                    } catch (err) {
                        console.error('Like error:', err);
                        alert('Có lỗi xảy ra khi thích bài viết. Vui lòng thử lại!');
                    }
                });
            }

            // ========== COMMENT ==========
            const btnSubmit = document.getElementById("btnSubmitComment");

            if (btnSubmit) {
                btnSubmit.addEventListener("click", function () {
                    const postId = this.getAttribute("data-postid");
                    const contentInput = document.getElementById("commentContent");
                    const errorText = document.getElementById("commentError");
                    const content = contentInput.value.trim();

                    if (content === "") {
                        errorText.textContent = "Vui lòng nhập nội dung bình luận trước khi gửi nha Boss!";
                        errorText.classList.remove("hidden");
                        return;
                    }
                    errorText.classList.add("hidden");

                    const formData = new FormData();
                    formData.append("postId", postId);
                    formData.append("content", content);

                    fetch('/Post/PostComment', {
                        method: 'POST',
                        body: formData
                    })
                        .then(response => {
                            if (response.ok) return response.json();
                            throw new Error("Lỗi hệ thống");
                        })
                        .then(data => {
                            const noCommentText = document.getElementById("noCommentText");
                            if (noCommentText) noCommentText.remove();

                            const now = new Date();
                            const timeString = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

                            const newCommentHtml = `
                                <div class="bg-orange-50/30 p-4 rounded-2xl border border-orange-100/50">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-sm font-bold text-orange-800">👤 ${data.user}</span>
                                        <span class="text-xs text-gray-400">🕒 ${timeString}</span>
                                    </div>
                                    <p class="text-sm text-gray-600 pl-5 whitespace-pre-line">${data.message}</p>
                                </div>
                            `;

                            const commentList = document.getElementById("commentList");
                            commentList.insertAdjacentHTML('afterbegin', newCommentHtml);
                            contentInput.value = "";
                        })
                        .catch(error => {
                            errorText.textContent = "Không thể gửi bình luận. Vui lòng kiểm tra lại kết nối!";
                            errorText.classList.remove("hidden");
                        });
                });
            }
        });
    </script>
}