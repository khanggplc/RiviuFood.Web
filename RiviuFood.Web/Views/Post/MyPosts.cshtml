@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<RiviuFood.Web.Models.Entities.Post>
@{
    ViewData["Title"] = "Bài viết của tôi";
}

<div class="max-w-6xl mx-auto my-10 px-4 font-sans">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h2 class="text-2xl font-black text-gray-800 tracking-tight">📝 Quản lý bài viết của Boss</h2>
            <p class="text-sm text-gray-400 mt-1">Danh sách tất cả các bài review món ngon Boss đã chia sẻ với cộng đồng.</p>
        </div>
        <a asp-controller="Post" asp-action="Create" class="w-fit bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm px-5 py-3 rounded-xl shadow-md transition flex items-center space-x-2">
            <span>+</span> <span>Viết bài review mới</span>
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/75 border-b border-gray-100 text-xs font-bold text-gray-400 uppercase tracking-wider">
                            <th class="py-4 px-6 w-24">Hình ảnh</th>
                            <th class="py-4 px-6">Thông tin bài viết</th>
                            <th class="py-4 px-6 w-40">Địa điểm quán</th>
                            <th class="py-4 px-6 w-28 text-center">Đánh giá</th>
                            <th class="py-4 px-6 w-40 text-center">Tác vụ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm text-gray-600">
                        @foreach (var post in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition duration-150">
                                <td class="py-4 px-6">
                                    <div class="w-16 h-16 rounded-xl bg-gray-100 overflow-hidden border border-gray-100 shadow-sm">
                                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "/images/default-food.jpg" : post.ImageUrl)" 
                                             alt="@post.Title" class="w-full h-full object-cover" />
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <a href="/Post/Details/@post.Id" target="_blank" class="font-bold text-gray-800 hover:text-orange-500 transition line-clamp-1">
                                        @post.Title
                                    </a>
                                    <span class="text-xs text-gray-400 block mt-1">🕒 Ngày đăng: @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="font-medium text-gray-700 block line-clamp-1">📍 @(post.Restaurant?.Name ?? "Chưa phân loại")</span>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-flex items-center space-x-1 bg-amber-50 px-2.5 py-1 rounded-lg text-amber-700 font-bold text-xs border border-amber-100">
                                        <span>⭐</span> <span>@post.Rating/5</span>
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <div class="flex items-center justify-center space-x-2">
                                        <a href="/Post/Edit/@post.Id" class="border border-gray-200 hover:border-orange-500 text-gray-600 hover:text-orange-500 font-medium text-xs px-3 py-2 rounded-lg transition">
                                            Sửa bài
                                        </a>
                                        <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post" onsubmit="return confirm('Boss có chắc chắn muốn xóa bài review này không? Hành động này không thể hoàn tác!');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="bg-red-50 hover:bg-red-500 text-red-600 hover:text-white font-medium text-xs px-3 py-2 rounded-lg transition">
                                                Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-4 bg-gray-50 border-t border-gray-100 flex items-center justify-center">
                <div class="pagination-container">
                    @Html.PagedListPager(Model, page => Url.Action("MyPosts", new { page }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new string[] { "inline-block", "mx-1" },
                            PageClasses = new string[] { "px-3.5", "py-2", "rounded-xl", "border", "border-gray-200", "text-sm", "font-semibold", "text-gray-600", "hover:bg-orange-500", "hover:text-white", "transition" },
                            ActiveLiElementClass = "bg-orange-500 text-white rounded-xl shadow-sm"
                        })
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-gray-200 shadow-sm">
            <span class="text-4xl">🥞</span>
            <h3 class="mt-4 text-base font-bold text-gray-800">Boss chưa đăng bài viết nào</h3>
            <p class="mt-1 text-sm text-gray-400 mb-6">Hãy chia sẻ trải nghiệm quán ăn ngon đầu tiên của mình nhé!</p>
            <a asp-controller="Post" asp-action="Create" class="bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm px-6 py-3 rounded-xl shadow-md transition">
                + Viết bài ngay
            </a>
        </div>
    }
</div>