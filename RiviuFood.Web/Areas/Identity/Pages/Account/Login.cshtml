@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-r from-orange-50 to-white p-4">
    <div class="w-full max-w-sm">
        <!-- LOGO RIVIU -->
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-block">
                <img src="~/images/logo.png" alt="Riviu Food Logo" class="h-auto" style="width: 300px;" />
            </a>
        </div>

        <!-- TIÊU ĐỀ -->
        <h1 class="text-4xl font-bold text-gray-700 text-center mb-8">Đăng nhập</h1>

        <!-- FORM ĐĂNG NHẬP -->
        <form id="account" method="post" class="space-y-4">
            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert"></div>

            <!-- EMAIL -->
            <div>
                <input asp-for="Input.Email" 
                       class="w-full px-4 py-3 bg-gray-100 border-0 rounded-lg text-gray-700 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:bg-white transition" 
                       autocomplete="username" 
                       aria-required="true" 
                       placeholder="Email" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- MẬT KHẨU -->
            <div class="relative">
                <input id="password-input"
                       asp-for="Input.Password" 
                       type="password"
                       class="w-full px-4 py-3 bg-gray-100 border-0 rounded-lg text-gray-700 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:bg-white transition" 
                       autocomplete="current-password" 
                       aria-required="true" 
                       placeholder="Mật khẩu" />
                <button type="button" 
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition"
                        onclick="togglePassword()">
                    <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                </button>
                <span asp-validation-for="Input.Password" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <!-- QUÊN MẬT KHẨU -->
            <div class="text-right">
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-gray-500 text-sm hover:text-orange-500 transition">
                    Quên mật khẩu?
                </a>
            </div>

            <!-- NÚT ĐĂNG NHẬP -->
            <button id="login-submit" 
                    type="submit" 
                    class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-full transition duration-200 shadow-md hover:shadow-lg">
                Đăng nhập
            </button>

                    </form>

                    <!-- DIVIDER -->
                    <div class="flex items-center my-6">
                        <div class="flex-1 border-t border-gray-300"></div>
                        <span class="px-3 text-gray-400 text-sm">hoặc</span>
                        <div class="flex-1 border-t border-gray-300"></div>
                    </div>

                    <!-- SOCIAL LOGIN -->
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <div class="grid grid-cols-2 gap-3">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <form id="@($"external-{provider.Name}")" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                        <button type="submit" 
                                                class="w-full bg-white border border-gray-200 hover:border-gray-300 rounded-lg py-3 flex items-center justify-center transition hover:shadow-md" 
                                                name="provider" 
                                                value="@provider.Name">
                                            @if (provider.Name == "Google")
                                            {
                                                <svg class="w-6 h-6" viewBox="0 0 24 24">
                                                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
                                                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
                                                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V6.07H2.18C1.43 7.84 1 9.37 1 12s.43 4.16 1.18 5.93l3.85-2.93z"></path>
                                                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 6.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
                                                </svg>
                                            }
                                            else if (provider.Name == "Facebook")
                                            {
                                                <svg class="w-6 h-6" viewBox="0 0 24 24">
                                                    <path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                                                </svg>
                                            }
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    }

                    <!-- LINK TẠO TÀI KHOẢN -->
                    <div class="text-center mt-8">
                        <p class="text-gray-600">
                            Chưa có tài khoản? 
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange-500 font-bold hover:text-orange-600 transition">
                                Tạo tài khoản
                            </a>
                        </p>
                    </div>
                </div>
            </div>

<script>
    function togglePassword() {
        const input = document.getElementById('password-input');
        const eyeIcon = document.getElementById('eye-icon');

        if (input.type === 'password') {
            input.type = 'text';
            eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-4.803m5.596-3.856a3.375 3.375 0 11-4.753 4.753m4.753-4.753L3.596 3.039"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>';
        } else {
            input.type = 'password';
            eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
