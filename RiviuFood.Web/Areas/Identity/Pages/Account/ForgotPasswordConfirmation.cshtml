@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-r from-orange-50 to-white p-4">
    <div class="w-full max-w-sm">
        <!-- LOGO RIVIU -->
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-block">
                <img src="~/images/logo.png" alt="Riviu Food Logo" class="h-auto" style="width: 300px;" />
            </a>
        </div>

        <!-- ICON EMAIL -->
        <div class="text-center mb-4">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-orange-100 rounded-full">
                <svg class="w-10 h-10 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
        </div>

        <!-- TIÊU ĐỀ -->
        <h1 class="text-3xl font-bold text-gray-700 text-center mb-3">Kiểm tra email</h1>
        <p class="text-gray-500 text-center mb-8 text-sm leading-relaxed">
            Nếu email bạn nhập tồn tại trong hệ thống, chúng tôi đã gửi một liên kết đặt lại mật khẩu. 
            Vui lòng kiểm tra hộp thư đến (và cả thư mục spam).
        </p>

        <!-- LINK QUAY VỀ -->
        <div class="text-center">
            <a asp-page="./Login"
               class="inline-block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-full transition duration-200 shadow-md hover:shadow-lg text-center">
                Quay về đăng nhập
            </a>
        </div>
    </div>
</div>
