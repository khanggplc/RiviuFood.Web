@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-r from-orange-50 to-white p-4">
    <div class="w-full max-w-sm">
        <!-- LOGO RIVIU -->
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-block">
                <img src="~/images/logo.png" alt="Riviu Food Logo" class="h-auto" style="width: 300px;" />
            </a>
        </div>

        <!-- ICON SUCCESS -->
        <div class="text-center mb-4">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full">
                <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
        </div>

        <!-- TIÊU ĐỀ -->
        <h1 class="text-3xl font-bold text-gray-700 text-center mb-3">Thành công!</h1>
        <p class="text-gray-500 text-center mb-8 text-sm leading-relaxed">
            Mật khẩu của bạn đã được đặt lại thành công. 
            Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.
        </p>

        <!-- NÚT ĐĂNG NHẬP -->
        <div class="text-center">
            <a asp-page="./Login"
               class="inline-block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-full transition duration-200 shadow-md hover:shadow-lg text-center">
                Đăng nhập ngay
            </a>
        </div>
    </div>
</div>
